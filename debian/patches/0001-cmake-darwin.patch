Description: CMake: build on Darwin
 Darwin does not symlink /bin, /sbin and /lib to /usr, so REQUIRE_MERGED_USR
 is off there. Berkeley DB is optional: without it, apt-ftparchive is not
 built. Darwin's C library has no memrchr(), so config.h falls back to a
 local one. Darwin's linker takes no version script and has no libutil to
 link. Without NLS, <locale.h> declares setlocale() on Darwin, so apti18n.h
 does not define its own.
Author: Maxwell <maxwell@blueberrypieos.com>
Forwarded: no
Last-Update: 2026-10-29

--- a/CMake/apti18n.h.in
+++ b/CMake/apti18n.h.in
@@ -1,6 +1,7 @@
 // -*- mode: cpp; mode: fold -*-
 /* Internationalization macros for apt. This header should be included last
    in each C file. */
+/* Modified 2026-10-29: build on Darwin (GPL-2 section 2(a)). */
 
 #ifndef APT_I18N_H
 #define APT_I18N_H
@@ -22,7 +23,11 @@
 # define N_(x) x
 #else
 // apt will not use any gettext
+#ifdef __APPLE__
+#include <locale.h>
+#else
 extern "C" inline char* setlocale(int, const char*) throw() { return nullptr; }
+#endif
 extern "C" inline char* textdomain(const char*) throw() { return nullptr; }
 extern "C" inline char* bindtextdomain(const char*, const char*) throw() { return nullptr; }
 extern "C" inline char* dgettext(const char*, const char* msg) throw() { return const_cast<char*>(msg); }
--- a/CMake/config.h.in
+++ b/CMake/config.h.in
@@ -1,3 +1,4 @@
+/* Modified 2026-10-29: build on Darwin (GPL-2 section 2(a)). */
 /* Define if your processor stores words with the most significant
    byte first (like Motorola and SPARC, unlike Intel and VAX).  */
 #cmakedefine WORDS_BIGENDIAN
@@ -52,6 +53,22 @@
 /* Check for ptsname_r() */
 #cmakedefine HAVE_PTSNAME_R
 
+/* GNU memrchr(), with a fallback where the C library lacks it (Darwin) */
+#cmakedefine HAVE_MEMRCHR
+#if !defined(HAVE_MEMRCHR) && !defined(APT_MEMRCHR_FALLBACK)
+#define APT_MEMRCHR_FALLBACK
+#include <string.h>
+static inline void *apt_memrchr(const void *s, int c, size_t n)
+{
+   const unsigned char *p = (const unsigned char *)s + n;
+   while (n-- != 0)
+      if (*--p == (unsigned char)c)
+	 return (void *)p;
+   return NULL;
+}
+#define memrchr apt_memrchr
+#endif
+
 /* Define the arch name string */
 #define COMMON_ARCH "${COMMON_ARCH}"
 
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,6 @@
 # Copyright (C) 2009, 2016 Software Freedom Conservancy
 # Licensed under the same terms as APT; i.e. GPL 2 or later.
+# Modified 2026-10-29: build on Darwin (GPL-2 section 2(a)).
 
 # set minimum version
 cmake_minimum_required(VERSION 3.13)
@@ -10,7 +11,12 @@ include_directories(${PROJECT_BINARY_DIR
 
 enable_testing()
 
-option(REQUIRE_MERGED_USR "Require merged-usr." ON)
+if (APPLE)
+  # Darwin does not symlink /bin, /sbin and /lib.
+  option(REQUIRE_MERGED_USR "Require merged-usr." OFF)
+else()
+  option(REQUIRE_MERGED_USR "Require merged-usr." ON)
+endif()
 option(WITH_DOC "Build all documentation." ON)
 include(CMakeDependentOption)
 cmake_dependent_option(WITH_DOC_MANPAGES "Force building manpages." OFF "NOT WITH_DOC" OFF)
@@ -88,7 +94,7 @@ add_optional_compile_options(Werror=sugg
 add_optional_compile_options(Werror=return-type)
 add_optional_compile_options(Wp,-D_GLIBCXX_ASSERTIONS)
 # apt-ftparchive dependencies
-find_package(Berkeley REQUIRED)
+find_package(Berkeley)
 if (BERKELEY_FOUND)
   set(HAVE_BDB 1)
 endif()
@@ -163,6 +169,8 @@ check_function_exists(setresuid HAVE_SET
 check_function_exists(setresgid HAVE_SETRESGID)
 check_function_exists(ptsname_r HAVE_PTSNAME_R)
 check_function_exists(timegm HAVE_TIMEGM)
+include(CheckCXXSymbolExists)
+check_cxx_symbol_exists(memrchr string.h HAVE_MEMRCHR)
 test_big_endian(WORDS_BIGENDIAN)
 
 # FreeBSD
@@ -253,7 +261,9 @@ add_subdirectory(cmdline)
 add_subdirectory(completions)
 add_subdirectory(doc)
 add_subdirectory(dselect)
+if (HAVE_BDB)
 add_subdirectory(ftparchive)
+endif()
 add_subdirectory(methods)
 add_subdirectory(test)
 
--- a/apt-pkg/CMakeLists.txt
+++ b/apt-pkg/CMakeLists.txt
@@ -1,3 +1,4 @@
+# Modified 2026-10-29: build on Darwin (GPL-2 section 2(a)).
 # Include apt-pkg directly, as some files have #include <system.h>
 include_directories(${PROJECT_BINARY_DIR}/include/apt-pkg)
 
@@ -61,7 +62,7 @@ target_include_directories(apt-pkg
 )
 
 target_link_libraries(apt-pkg
-                      PRIVATE -lutil ${CMAKE_DL_LIBS} ${RESOLV_LIBRARIES}
+                      PRIVATE $<$<NOT:$<PLATFORM_ID:Darwin>>:-lutil> ${CMAKE_DL_LIBS} ${RESOLV_LIBRARIES}
                              ${CMAKE_THREAD_LIBS_INIT}
                              ${ZLIB_LIBRARIES}
                              ${BZIP2_LIBRARIES}
@@ -77,7 +78,9 @@ target_link_libraries(apt-pkg
 set_target_properties(apt-pkg PROPERTIES VERSION ${MAJOR}.${MINOR})
 set_target_properties(apt-pkg PROPERTIES SOVERSION ${MAJOR})
 set_target_properties(apt-pkg PROPERTIES CXX_VISIBILITY_PRESET hidden)
+if (NOT APPLE)
 target_link_libraries(apt-pkg PRIVATE -Wl,-version-script="${CMAKE_CURRENT_BINARY_DIR}/versionscript")
+endif()
 
 # Install the library and the header files
 install(TARGETS apt-pkg LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR})
