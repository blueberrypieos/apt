+}
+constexpr APT::Solver::Solver::State &APT::Solver::Solver::operator[](const pkgCache::Version *V) noexcept
+{
+   return verStates[V];
+}
+constexpr const APT::Solver::Solver::State &APT::Solver::Solver::operator[](const pkgCache::Version *V) const noexcept
+{
+   return verStates[V];
+}
