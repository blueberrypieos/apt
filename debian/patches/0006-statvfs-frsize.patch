Description: Free space from statvfs's f_frsize
 statvfs counts f_bavail and f_bfree in f_frsize units. On Darwin, f_bsize
 is the preferred I/O size and much larger, which overstated the free
 space.
Author: Maxwell <maxwell@blueberrypieos.com>
Forwarded: no
Last-Update: 2026-10-29

--- a/apt-private/private-download.cc
+++ b/apt-private/private-download.cc
@@ -1,3 +1,4 @@
+// Modified 2026-10-29: free space from statvfs's f_frsize (GPL-2 section 2(a)).
 // Include Files							/*{{{*/
 #include <config.h>
 
@@ -144,7 +145,7 @@ bool CheckFreeSpaceBeforeDownload(std::s
 	       Dir.c_str());
    }
    unsigned long long const FreeBlocks = _config->Find("APT::Sandbox::User").empty() ? Buf.f_bfree : Buf.f_bavail;
-   if (FreeBlocks >= (FetchBytes / Buf.f_bsize))
+   if (FreeBlocks >= (FetchBytes / Buf.f_frsize))
       return true;
    struct statfs Stat;
    if (statfs(Dir.c_str(), &Stat) != 0)
