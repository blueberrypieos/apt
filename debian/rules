#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors

include /usr/share/pietoolchain/rules.mk

BINUTILS := $(TOOLCHAIN)/prefix/bin/aarch64-apple-darwin
DEST     := $(OBJ)/dest

BINS    := apt apt-get apt-cache apt-mark apt-config
METHODS := http https file copy store gpgv rred mirror \
	mirror+http mirror+https mirror+file mirror+copy
DIRS    := etc/apt/apt.conf.d etc/apt/auth.conf.d etc/apt/preferences.d \
	etc/apt/sources.list.d etc/apt/trusted.gpg.d \
	var/lib/apt/lists/partial var/lib/apt/mirrors/partial var/lib/apt/periodic \
	var/cache/apt/archives/partial var/log/apt

$(OBJ)/build.ninja:
	DEB_HOST_ARCH=darwin-arm64 PKG_CONFIG_LIBDIR=$(SDK)/usr/lib/pkgconfig \
	cmake -G Ninja -S $(SRCROOT) -B $(OBJ) -DCMAKE_SYSTEM_NAME=Darwin \
		-DCMAKE_OSX_SYSROOT=$(SDK) -DCMAKE_OSX_ARCHITECTURES=$(ARCH) \
		-DCMAKE_OSX_DEPLOYMENT_TARGET=26.5 \
		-DCMAKE_C_COMPILER=$(CC) -DCMAKE_CXX_COMPILER=$(CXX) \
		-DCMAKE_C_FLAGS="$(BASE_CFLAGS)" -DCMAKE_CXX_FLAGS="$(BASE_CFLAGS) -stdlib=libc++" \
		-DCMAKE_EXE_LINKER_FLAGS="$(BASE_LDFLAGS) -Wl,-exported_symbol,__mh_execute_header" \
		-DCMAKE_SHARED_LINKER_FLAGS="$(BASE_LDFLAGS) -Wl,-no_warn_inits" \
		-DCMAKE_AR=$(BINUTILS)-ar -DCMAKE_RANLIB=$(BINUTILS)-ranlib \
		-DCMAKE_INSTALL_NAME_TOOL=$(BINUTILS)-install_name_tool -DCMAKE_NM=$(BINUTILS)-nm \
		-DCMAKE_OBJDUMP=$(BINUTILS)-otool -DCMAKE_STRIP=$(BINUTILS)-strip \
		-DCMAKE_FIND_ROOT_PATH=$(SDK) -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER \
		-DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY \
		-DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY \
		-DOPENSSL_ROOT_DIR=$(SDK)/usr -DOPENSSL_USE_STATIC_LIBS=OFF \
		-DCMAKE_DISABLE_FIND_PACKAGE_Udev=ON \
		-DCMAKE_BUILD_TYPE=MinSizeRel -DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc -DCMAKE_INSTALL_LOCALSTATEDIR=/var \
		-DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_NAME_DIR=/usr/lib \
		-DCMAKE_BUILD_WITH_INSTALL_NAME_DIR=ON \
		-DTRIEHASH_EXECUTABLE=/usr/bin/triehash -DSQV_EXECUTABLE=OFF \
		-DCURRENT_VENDOR=debian -DROOT_GROUP=wheel -DDPKG_DATADIR=/usr/share/dpkg \
		-DUSE_NLS=OFF -DWITH_DOC=OFF -DWITH_TESTS=OFF -DREQUIRE_MERGED_USR=OFF
	grep -qx '/\* #undef SQV_EXECUTABLE \*/' $(OBJ)/include/config.h || { rm -f $@; \
		echo "apt: config.h does not undefine SQV_EXECUTABLE, so this apt might use sqv" >&2; exit 1; }

all: $(OBJ)/build.ninja
	ninja -C $(OBJ) -j$(JOBS)

install: all
	rm -rf $(DEST)
	DESTDIR=$(DEST) cmake --install $(OBJ)
	install -d $(ROOT)/usr/bin $(ROOT)/usr/lib/apt/methods
	set -e; for f in $(BINS); do install -m 755 $(DEST)/usr/bin/$$f $(ROOT)/usr/bin/; done
	cp -P $(DEST)/usr/lib/libapt-pkg*.dylib $(DEST)/usr/lib/libapt-private*.dylib $(ROOT)/usr/lib/
	set -e; for f in $(METHODS); do cp -P $(DEST)/usr/lib/apt/methods/$$f $(ROOT)/usr/lib/apt/methods/; done
	install -m 755 $(DEST)/usr/lib/apt/apt-helper $(ROOT)/usr/lib/apt/
	set -e; for d in $(DIRS); do install -d $(ROOT)/$$d; done
	install -m 644 debian/untrusted-hashes $(ROOT)/etc/apt/apt.conf.d/01untrusted-hashes

.PHONY: all install
